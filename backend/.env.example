# Flood Cloud backend: names only. Copy to .env (never versioned) and fill in the values.
# Required variables have no default; the server refuses to start if they are missing or invalid.

# Required. Execution environment: development | production. Part of every database name.
APP_ENV=

# Optional. TCP port (1-65535). Default: 3000
PORT=

# Required, secret. MongoDB connection string, must start with mongodb:// or mongodb+srv://
MONGODB_URI=

# Optional. Prefix of every database name, ^[A-Za-z0-9_-]{0,32}$. Default: empty
DB_NAME_PREFIX=

# Optional. Exact number of reverse proxies in front of the server (0 = none). Default: 0
TRUST_PROXY=

# Optional. Comma-separated exact origins allowed by CORS on /v1 (scheme://host[:port], no path).
# https only; http is accepted for localhost and 127.0.0.1 when APP_ENV=development. Default: empty (CORS closed)
CORS_ALLOWED_ORIGINS=

# Optional. Access token lifetime in seconds. Default: 900
ACCESS_TOKEN_TTL_SECONDS=

# Optional. Refresh token idle lifetime in seconds. Default: 604800
REFRESH_IDLE_TTL_SECONDS=

# Optional. Absolute session lifetime in seconds, >= REFRESH_IDLE_TTL_SECONDS. Default: 2592000
SESSION_MAX_TTL_SECONDS=

# Optional. Pause in milliseconds (0-20000) between the shutdown signal and closing the server,
# so the load balancer sees readiness fail first. Default: 5000
SHUTDOWN_DRAIN_MS=

# Optional. Request timeout in milliseconds (1000-300000). Default: 30000
REQUEST_TIMEOUT_MS=

# Required, secret. Pepper of the legacy password hashes: non-empty, no leading or trailing whitespace.
LEGACY_PASSWORD_PEPPER=
