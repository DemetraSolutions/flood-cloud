# Flood Cloud backend: names only. Copy to .env (never versioned) and fill in the values.
# Required variables have no default; the server refuses to start if they are missing or invalid.

# Required. Execution environment: development | production. Part of every database name.
APP_ENV=

# Optional. TCP port (1-65535). Default: 3000
PORT=

# Optional. Address to bind: an IP address or a hostname. Default: all interfaces
HOST=

# Required in single-cluster mode (MONGODB_CLUSTERS unset), secret. MongoDB connection string, must start with
# mongodb:// or mongodb+srv://. With APP_ENV=production only mongodb+srv:// or mongodb:// with tls=true in the
# query are accepted (the same rule applies to every connection string below). In this mode there is one cluster, cluster0.
# With MONGODB_CLUSTERS set, MONGODB_URI must be unset: use MONGODB_URI_<ID> instead.
MONGODB_URI=

# Optional, secret. Connection string of a more powerful node for heavy reads (statistics, reports) of cluster0.
# Unset: analytics reads use MONGODB_URI with readPreference secondaryPreferred. Nothing is ever written through it.
MONGODB_ANALYTICS_URI=

# Optional. Multi-cluster mode: comma-separated cluster ids, each ^[a-z][a-z0-9-]{0,31}$, unique, at most 16 (e.g. cluster0,cluster1).
# Login and common data always live on the common cluster; the data of a group on the cluster named by the
# `dataCluster` field of its group document (absent: MONGODB_DEFAULT_GROUP_CLUSTER). Unset: single-cluster mode.
# For each id X (upper case, "-" becomes "_") set MONGODB_URI_X (required, secret) and, optionally,
# MONGODB_ANALYTICS_URI_X (secret; same meaning as MONGODB_ANALYTICS_URI, which must then be unset), e.g. MONGODB_URI_CLUSTER0, MONGODB_URI_CLUSTER1.
MONGODB_CLUSTERS=

# Optional. Cluster of the common database (identity, tenancy, security); must be in MONGODB_CLUSTERS.
# Default: the first id of the list (cluster0 in single-cluster mode)
MONGODB_COMMON_CLUSTER=

# Optional. Cluster of the groups whose document has no dataCluster; must be in MONGODB_CLUSTERS.
# Default: the common cluster
MONGODB_DEFAULT_GROUP_CLUSTER=

# Optional. MongoDB server selection and connect timeout in milliseconds (1000-60000). Default: 5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=

# Optional. Maximum size of the MongoDB connection pool (1-500). Default: 20
MONGODB_MAX_POOL_SIZE=

# Optional. Prefix of every database name, ^[A-Za-z0-9_-]{0,27}$ (MongoDB limits database names to
# 63 bytes: prefix + environment + "_" + 24 hex of the group id). Default: empty
DB_NAME_PREFIX=

# Optional. Exact number of reverse proxies in front of the server (0 = none). Default: 0
TRUST_PROXY=

# Optional. Comma-separated exact origins allowed by CORS on /v1 (scheme://host[:port], no path).
# https only; http is accepted for localhost and 127.0.0.1 when APP_ENV=development. Default: empty (CORS closed)
CORS_ALLOWED_ORIGINS=

# Optional. Access token lifetime in seconds. Default: 900
ACCESS_TOKEN_TTL_SECONDS=

# Optional. Refresh token idle lifetime in seconds. Default: 604800
REFRESH_IDLE_TTL_SECONDS=

# Optional. Absolute session lifetime in seconds, >= REFRESH_IDLE_TTL_SECONDS. Default: 2592000
SESSION_MAX_TTL_SECONDS=

# Optional. Seconds (0-300) after a refresh during which a retry of the old refresh token is
# tolerated as a network race instead of revoking the session. Default: 30
REFRESH_REUSE_GRACE_SECONDS=

# Optional. Pause in milliseconds (0-20000) between the shutdown signal and closing the server,
# so the load balancer sees readiness fail first. Default: 5000
SHUTDOWN_DRAIN_MS=

# Optional. Request timeout in milliseconds (1000-300000). Default: 30000
REQUEST_TIMEOUT_MS=

# Required, secret. Pepper of the legacy password hashes: non-empty, no leading or trailing whitespace.
LEGACY_PASSWORD_PEPPER=

# Required, secret. Key of the HMAC-SHA256 that signs the version (ETag) of companies and places: base64 or
# base64url text of at least 32 random bytes (e.g. `openssl rand -base64 32`). Changing it changes every ETag.
VERSION_HMAC_KEY=

# Optional. true | false. While the legacy system still runs, a password change also writes the legacy
# hash so the legacy keeps accepting it. Turn off at the final cutover (then the old legacy password stops
# working for users whose password was changed here). Default: true
LEGACY_PASSWORD_COEXISTENCE=

# Optional. Rate limit thresholds: requests per fixed window of one minute (1-100000). Beyond them the
# API answers 429 RATE_LIMITED with Retry-After. Defaults: login per username 5, login per IP 15,
# refresh per IP 30, username availability check per user 15, /v1 API per user 300
RATE_LIMIT_LOGIN_PER_USERNAME=
RATE_LIMIT_LOGIN_PER_IP=
RATE_LIMIT_REFRESH_PER_IP=
RATE_LIMIT_USERNAME_CHECK_PER_USER=

# Optional. User creations and password resets per minute allowed to one user (1-100000); each costs a
# scrypt run. Beyond it the API answers 429. Default: 20
RATE_LIMIT_USER_CREDENTIALS_PER_USER=
RATE_LIMIT_API_PER_USER=

# Optional. Browser error reports (POST /v1/client-errors) per minute allowed to one user (1-100000);
# beyond it the API answers 429. Default: 30
RATE_LIMIT_CLIENT_ERRORS_PER_USER=

# Optional. Image uploads (POST /v1/groups/{groupId}/media/images) per minute allowed to one user
# (1-100000): each decodes and resizes an image and writes five objects. Default: 30
RATE_LIMIT_MEDIA_UPLOAD_PER_USER=

# Optional. Image uploads per day (a quota, window of 24 hours) allowed to one user and to one group
# (1-1000000); beyond them the API answers 429 with Retry-After. Defaults: 300 per user, 2000 per group
RATE_LIMIT_MEDIA_UPLOAD_PER_USER_DAILY=
RATE_LIMIT_MEDIA_UPLOAD_PER_GROUP_DAILY=

# Optional. Store keys (the key of the server of a point of sale, step 7C). Requests per minute allowed to one
# key on the /v1 API (1-1000000), default 600; activation code exchanges (POST /v1/store-activations) per minute
# allowed to one client IP (1-100000), default 10; code creations, cancellations and revocations per minute allowed
# to one user (1-100000), default 20; minutes an activation code stays valid (5-10080), default 1440 (24 hours)
RATE_LIMIT_API_PER_STORE=
RATE_LIMIT_STORE_ACTIVATION_PER_IP=
RATE_LIMIT_STORE_KEY_ADMIN_PER_USER=
STORE_ACTIVATION_CODE_TTL_MINUTES=

# Optional. Host of the files (images) of the groups, written in the `filesHost` of every group the onboarding of a new
# customer creates (`POST /v1/groups`): an https URL without credentials, query or fragment, e.g. the public address of the
# bucket of the media. Unset: the new groups have an empty `filesHost` and their images have no URLs
GROUP_FILES_HOST=

# Optional. Failed authentications (401) per minute allowed to a client IP on /v1 (1-100000); beyond it
# the IP gets 429 before its credentials are even checked. Successful requests do not count. Default: 300
RATE_LIMIT_UNAUTHENTICATED_PER_IP=

# Optional. Days the activity log keeps data and security entries (1-3650). Default: 365
ACTIVITY_LOG_RETENTION_DAYS=

# Optional. Days the activity log keeps error entries (1-3650). Default: 90
ACTIVITY_LOG_ERROR_RETENTION_DAYS=

# Optional. Where the uploaded images are stored: gcs (Google Cloud Storage) or disabled. Default:
# disabled (the upload answers 503 SERVICE_UNAVAILABLE, the list of the images still works)
MEDIA_STORAGE=

# Required with MEDIA_STORAGE=gcs. Name of the bucket (3-63 characters: lower case letters, digits,
# dots, dashes, underscores). The value belongs to the real environment, never to the repository
GCS_MEDIA_BUCKET=

# Required with MEDIA_STORAGE=gcs. How the server authenticates to the storage: metadata (the token of
# the metadata server, GKE Workload Identity: nothing else to configure) or service-account-file (a
# JWT signed with the key of a credentials file, for development)
GCS_AUTH=

# Required with GCS_AUTH=service-account-file. Path of the credentials JSON file of a service account
# with the minimum permissions on the bucket (object create and delete). Read once at start-up. The
# file stays outside the repository
GCS_SERVICE_ACCOUNT_FILE=
