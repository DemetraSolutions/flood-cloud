#!/bin/sh
# Blocks the commit if gitleaks finds secrets in the staged changes.
# Uses a local gitleaks binary if installed, otherwise the official image pinned by digest.
# Enable once per clone with: ./scripts/install-git-hooks.sh
set -eu

GITLEAKS_IMAGE="ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f"
ROOT="$(git rev-parse --show-toplevel)"

if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --pre-commit --staged --redact --no-banner --exit-code 1 "$ROOT"
fi

if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  exec docker run --rm --network none -v "$ROOT:/repo:ro" -w /repo "$GITLEAKS_IMAGE" \
    git --pre-commit --staged --redact --no-banner --exit-code 1 /repo
fi

echo "pre-commit: gitleaks not available (install gitleaks or start Docker). Commit blocked." >&2
exit 1
