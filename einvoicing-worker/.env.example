# Flood Cloud e-invoicing worker: names only. Copy to .env (never versioned) and fill in the values.
# Required variables have no default; the worker refuses to start if they are missing or invalid.
# With APP_ENV=production a .env file in the working directory stops the startup (a deployed worker takes its secrets from the secret manager).

# Required. Execution environment: development | production. Part of every database name.
APP_ENV=

# Required, secret. MongoDB connection string of the common cluster (cluster0), must start with mongodb:// or mongodb+srv://.
# With APP_ENV=production only mongodb+srv:// or mongodb:// with tls=true in the query are accepted.
MONGODB_URI=

# Optional. Prefix of every database name, ^[A-Za-z0-9_-]{0,27}$. Default: empty
DB_NAME_PREFIX=

# Required. Identity of this instance in the lease, ^[A-Za-z0-9._-]{1,128}$. On GKE the pod name (fieldRef metadata.name).
WORKER_INSTANCE_ID=

# Optional. Lease lifetime in milliseconds (10000-300000). Default: 30000
LEASE_TTL_MS=

# Optional. Lease renewal and acquisition retry period in milliseconds (1000-300000, less than LEASE_TTL_MS / 2). Default: 10000
LEASE_RENEW_MS=

# Optional. Pause between two rounds of jobs, in milliseconds (1000-600000). Default: 5000
LOOP_INTERVAL_MS=

# Optional. TCP port (1-65535) of the liveness probe. Default: 8080
HEALTH_PORT=

# Optional. The probe fails when the loop has not ticked for this long, in milliseconds (greater than LOOP_INTERVAL_MS, at most 3600000). With a hub enabled it must also cover the round budget, the longest provider call
# (90000 for Aruba) and a 30000 margin: the worker refuses to start otherwise. Default: 180000
HEALTH_STALE_MS=

# Optional. Minimum log level: debug | info | warn | error. Default: info
LOG_LEVEL=

# Optional. Operating mode: shadow | send. Default: shadow. In shadow the worker NEVER calls a provider, claims or modifies a
# queue record, reads an account or a credential (CREDENTIALS_PRIVATE_KEY*, ARUBA_ENVIRONMENT and WORKER_HUBS are ignored):
# it only runs the send pipeline on the queue and stores a report per record in einvoicingShadowReports.
# Use send only after the legacy cron stopped (see the switch-over runbook in doc/Technical-Guide.md, section 13).
WORKER_MODE=

# Optional, shadow mode only. Hubs to analyse: the same format as WORKER_HUBS, or * alone for every hub. Empty = analyse nothing. Default: empty
SHADOW_HUBS=

# Optional, shadow mode only. Queue records analysed per round (1-1000). Default: 50
SHADOW_BATCH=

# Optional, shadow mode only. Only queue records created in the last N days are analysed (1-365): older ones would be
# falsely refused by the date checks. Default: 30
SHADOW_LOOKBACK_DAYS=

# Optional. Build identifier (the image tag), ^[A-Za-z0-9._-]{1,64}$: part of the shadow code version, so a new deploy analyses
# every record again. The Deployment sets it to the commit SHA.
BUILD_SHA=

# Optional, send mode only. SAFETY SWITCH: comma-separated allowlist of the hubs this worker may process (aruba, aruba__<24 hexadecimal characters>).
# Empty or absent = the worker processes nothing (it runs, logs "no hubs enabled" and touches no record). Enable a hub only
# after the legacy cron stopped sending for it, or an invoice is sent twice. Default: empty
WORKER_HUBS=

# Send mode only: required when WORKER_HUBS is not empty, secret. Private key of the credentials the backend encrypts (PEM, PKCS#8, X25519).
# In .env use double quotes with \n for the line breaks. In the secret manager store it without a trailing line break (printf '%s').
CREDENTIALS_PRIVATE_KEY=

# Required with CREDENTIALS_PRIVATE_KEY (both or none), ^[a-z0-9-]{1,32}$: must equal the backend's CREDENTIALS_PUBLIC_KEY_ID.
CREDENTIALS_PRIVATE_KEY_ID=

# Send mode only: required when WORKER_HUBS lists an aruba hub: demo | production. Decides only the Aruba hosts (demoauth/demows or auth/ws
# fatturazioneelettronica.aruba.it); there is no way to give a URL. Use demo with Aruba's demo credentials until the cutover.
ARUBA_ENVIRONMENT=

# Optional. How often the provider accounts are read again, in milliseconds (10000-3600000). Default: 120000
ACCOUNTS_REFRESH_MS=

# Optional. Lifetime of the claim on a queue record, in milliseconds (30000-900000, greater than TICK_BUDGET_MS, and, with a hub enabled, greater than the round budget plus the longest provider call, 90000 for Aruba). Default: 240000
RECORD_LEASE_MS=

# Optional. Time budget of one round of the upload and status jobs, in milliseconds (2000-600000); the engine uses at most
# HEALTH_STALE_MS - longest provider call - 30000 so a tick always ends well inside the liveness window. Default: 30000
TICK_BUDGET_MS=
